<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Opt-in: does nothing until the user enables it under Settings,
             Accessibility. Used only to put the screen into split screen for
             app pairs (and later to lock the screen on double-tap). It reads
             no window content and receives no events. -->
        <service
            android:name="org.buetow.turbolaunch.TurboLaunchAccessibilityService"
            android:exported="false"
            android:label="@string/turbolaunch_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/turbolaunch_accessibility" />
        </service>
    </application>
</manifest>
