<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Swipe down on the home screen pulls the notification shade. A normal
         permission, granted at install. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <application>
        <!-- Opt-in: does nothing until the user enables it under Settings,
             Accessibility. Used only for three global actions: split screen for
             app pairs, locking the screen on a double-tap, and pulling down
             the notification shade. It reads
             no window content and receives no events. -->
        <service
            android:name="org.buetow.turbolaunch.TurboLaunchAccessibilityService"
            android:exported="false"
            android:label="@string/turbolaunch_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/turbolaunch_accessibility" />
        </service>
    </application>
</manifest>
